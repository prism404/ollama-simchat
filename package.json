{
  "name": "local-character-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first character chat memory core using SQLite and Ollama",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"web/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/**/*.{ts,tsx,css,html,json}\"",
    "db:init": "node src/db/init.ts",
    "db:check": "node src/db/check.ts",
    "db:inspect": "node src/db/inspect.ts",
    "db:seed-demo": "node src/db/seed-demo.ts",
    "db:chat-context": "node src/db/check-chat-context.ts",
    "chat:prompt": "node src/chat/check-prompt.ts",
    "test:memory": "node --test src/memory/*.test.ts",
    "memory:propose": "node src/memory/check-memory-candidates.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
